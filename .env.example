# RefPay environment variable NAMES. Never commit real values.
#
# HOSTED (PayBox portal): API keys are NOT env vars. Add them under
# Variables & Secrets -> Secret (host-scoped brokered header):
#   host api.groq.com               header Authorization   value "Bearer gsk_..."
#   host base-mainnet.g.alchemy.com header Authorization   value "Bearer <alchemy key>"
#
# LOCAL DEV ONLY (pnpm dev / local conformance). Hosted plugins never see these.
REFPAY_DEV_GROQ_KEY=
REFPAY_DEV_ALCHEMY_KEY=

# Optional non-sensitive overrides (portal: Environment variable). Defaults in src/config.ts.
REFPAY_GROQ_MODEL=openai/gpt-oss-20b
REFPAY_LARGE_ABS_USDC=1000
REFPAY_LARGE_MEDIAN_MULTIPLE=3
REFPAY_DUST_USDC=0.01
REFPAY_MAX_RATE_DEVIATION_PCT=3
REFPAY_HISTORY_COUNT=50
